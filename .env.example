# ==============================================================================
# Zoho Mail SMTP Configuration for Hero Link Systems Limited
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. In Zoho Mail / Zoho Accounts (https://accounts.zoho.com):
#    - Go to Security -> Application-Specific Passwords
#    - Click "Generate New Password", label it "Website Enquiry Form"
#    - Copy the generated 16-character password and paste it into EMAIL_PASS below.
# 3. For Vercel or production hosting, add these exact environment variables
#    in your project deployment settings.
# ==============================================================================

# Zoho Outgoing SMTP Server
# For Zoho Workplace / Custom Domain: smtppro.zoho.com (port 465 SSL or 587 TLS)
# For personal @zoho.com accounts: smtp.zoho.com
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true

# Authentication (Official business email on Zoho)
EMAIL_USER=info@herolinksystems.com
EMAIL_PASS=your_zoho_app_password_here

# Recipient (Enquiries will be delivered here)
EMAIL_TO=info@herolinksystems.com

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.herolinksystems.com
