# Email configuration — copy to .env.local and fill in real values
# NEVER commit .env.local to version control

EMAIL_USER=info@herolinksystems.com
# Use an App Password (not your main password)
# Generate one in your email provider's security settings
EMAIL_PASS=your_app_password_here
EMAIL_TO=info@herolinksystems.com

# Optional: site URL for canonical links
NEXT_PUBLIC_SITE_URL=https://www.herolinksystems.com
